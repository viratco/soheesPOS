# Supabase (Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# "Secret" key (or legacy "service_role"). Only used by the seed script. Never put this in frontend/.
SUPABASE_SECRET_KEY=

# Logins created by `npm run seed`
# Staff: comma-separated email:password pairs
STAFF_LOGINS=owner@soheeskitchen.in:change-me-1,staff@soheeskitchen.in:change-me-2
# Kitchen tablet account. Must match KITCHEN_EMAIL / KITCHEN_PASSWORD in frontend/.env.local
KITCHEN_EMAIL=kitchen@soheeskitchen.in
KITCHEN_PASSWORD=change-me-kitchen
